{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "build/**",
    "DerivedData/**",
    "node_modules/**",
    ".swiftpm/**",
    ".orkestrator/**",
    ".claude/**",
    "**/__pycache__/**",
    "VulkanGlass.xcodeproj/**",
    "**/*.xcassets/**",
    "VulkanGlass/Assets.xcassets/**",
    "resources/**",
    "SampleVault/**",
    "**/*.md",
    "**/*.swift",
    "**/*.py",
    "mise.lock"
  ]
}
