{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "build/**",
    "DerivedData/**",
    "node_modules/**",
